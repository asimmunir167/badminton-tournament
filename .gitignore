backend/dist/
admin/.next/
admin/out/

# logs
*.log
npm-debug.log*

# docker volumes (bind-mounted local data, if any)
.docker-data/

# Claude Code local/personal state (not shared project config)
.claude/settings.local.json
.claude/scheduled_tasks.lock
