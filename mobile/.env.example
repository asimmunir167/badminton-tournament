# Copy to .env and adjust as needed. .env is gitignored.
# EXPO_PUBLIC_ vars are inlined into the client bundle.

# Backend API base URL. Use localhost for the web/simulator build, or your
# dev machine's LAN IP (e.g. http://192.168.1.23:4000) when testing on a
# physical Android device over Wi-Fi — see AGENTS.md section 26.
EXPO_PUBLIC_API_URL=http://localhost:4000
