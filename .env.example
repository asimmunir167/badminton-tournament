# Copy this file to .env and adjust as needed. .env is gitignored.

# --- Postgres (used by docker-compose and backend) ---
POSTGRES_USER=tournament
POSTGRES_PASSWORD=tournament
POSTGRES_DB=tournament
DATABASE_URL=postgresql://tournament:tournament@localhost:5432/tournament

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object storage for local dev) ---
MINIO_ROOT_USER=tournament
MINIO_ROOT_PASSWORD=tournament123
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tournament-app
S3_ACCESS_KEY=tournament
S3_SECRET_KEY=tournament123
S3_FORCE_PATH_STYLE=true

# --- Backend ---
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OTP / SMS (dev default: logs OTP to console instead of sending) ---
OTP_PROVIDER=console
# OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
